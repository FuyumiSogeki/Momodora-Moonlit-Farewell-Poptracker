{
  //sets the trackers layout
  //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
  "item_grid": 
  {
    "type": "itemgrid",
    "h_alignment": "center",
    "item_margin": "2,3,-10,-10",
    "item_size": "60,60",
    "rows": 
    [
      ["awakened_sacred_leaf","sacred_anemone","crescent_moonflower"],
      ["spiral_shell","lunar_attunement","mitchi_fast_travel"],
      ["grimoire","tattered_grimoire","dusty_grimoire"],
      ["gold_moonlit_dust","silver_moonlit_dust","windmill_key"],
      ["progressive_final_boss_key"]
    ]
  },
  "setting_grid": {
    "type": "itemgrid",
    "h_alignment": "center",
    "item_margin": "2,3,-10,-10",
    "item_size": "60,60",
    "rows": 
    [
      ["bell_hover_on","open_springleaf_on","key_items_on"],
      ["final_boss_key_on","oracle_sigil_on","fairy_on"],
      ["berry_on","lily_on","lunar_on"],
      ["","companion_on",""]
    ]
  },
  "tracker_horizontal": 
  {
    "type": "container",
    "background": "#000000",
    "content": 
    {
      "type": "dock",
      "dropshadow": true,
      "content": 
      [
        {
          "type": "dock",
          "dock": "left",
          "content":
          [
            {
              "type": "group",
              "header": "Skills & Grimoires",
              "header_content": 
              {
                "type": "button_popup",
                "style": "settings",
                "popup_background": "#55212121",
                "layout": "settings_popup"
              },
              "content": 
              {
                "type": "array",
                "orientation": "horizontal",
                "margin": "0,0",
                "dock": "top",
                "content": 
                [
                  {
                    "type": "layout",
                    "key": "item_grid"
                  }
                ]
              }
            },
            {
              "type": "group",
              "header": "Settings",
              "header_content": 
              {
                "type": "button_popup",
                "style": "settings",
                "popup_background": "#55212121",
                "layout": "settings_popup"
              },
              "content": 
              {
                "type": "array",
                "orientation": "horizontal",
                "margin": "0,0",
                "dock": "bottom",
                "content": 
                [
                  {
                    "type": "layout",
                    "key": "setting_grid"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "dock",
          "dock": "right",
          "content": 
          [
            {
              "type": "dock",
              "dock": "top",
              "content": 
              [
                {
                  "title": "Sigils",
                  "type": "group",
                  "content": 
                  {
                    "type": "layout",
                    "h_alignment": "center",
                    "v_alignment": "center",
                    "key": "sigil_grid"
                  }
                },
                {
                  "title": "Collectables",
                  "type": "group",
                  "content": 
                  {
                    "type": "layout",
                    "h_alignment": "center",
                    "v_alignment": "center",
                    "key": "collectables"
                  }
                },
                {
                  "title": "Companions",
                  "type": "group",
                  "content": 
                  {
                    "type": "layout",
                    "h_alignment": "center",
                    "v_alignment": "center",
                    "key": "companions"
                  }
                }
              ]
            }            
          ]
        },
        {
          "type": "tabbed",
          "tabs": 
          [
            {
              "title": "Full Map",
              "content": 
              {
                "type": "map",
                "maps": 
                [
                  "Full Map"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
